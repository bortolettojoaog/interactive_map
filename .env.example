# This is a static site with no secrets — these vars control the Docker
# setup and get baked into the build (no server-side runtime config).

# Port the container is published on for local `docker-compose up` (docker-compose.yml)
PORT=3001

# Image tag pulled from hub.bortolettotech.com in production (docker-compose.deploy.yml).
# Also the version shown in the app footer (see VITE_APP_VERSION below) — keep this
# in sync with the tag passed to devops/ci-cd.sh when cutting a release.
INTERACTIVE_MAP_VERSION=0.0.0

# Read by Vite at build time and exposed to the app as import.meta.env.VITE_APP_VERSION.
VITE_APP_VERSION=${INTERACTIVE_MAP_VERSION}
